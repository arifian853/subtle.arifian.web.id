{
  "name": "subtle-showcase",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "dev:api": "bun apps/api/src/dev.ts",
    "test": "bun test tests",
    "typecheck": "bun run --cwd apps/web check && tsc --noEmit -p tsconfig.json",
    "build": "bun run --cwd apps/web build",
    "test:browser": "bun scripts/browser-qa.ts",
    "audit:artifact": "bun scripts/audit.ts",
    "audit:a11y-dom": "bun build scripts/axe-dom.ts --target=node --packages=external --outfile=.qa/axe-dom.mjs && node .qa/axe-dom.mjs",
    "licenses": "bun scripts/licenses.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "24.19.1",
    "bun-types": "1.4.2",
    "playwright": "1.63.0",
    "axe-core": "4.14.0",
    "shadcn": "4.21.0",
    "jsdom": "30.1.2",
    "@testing-library/react": "16.3.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
