---
import Layout from '../../layouts/Layout.astro';
import { catalog } from '@subtle/catalog';
import { ModeComparison } from '../../components/ModeComparison';
import { SettingsForm } from '../../components/SettingsForm';
import { DataDemo, Metric } from '../../components/DataDemo';
import { Conversation } from '../../components/Conversation';
import { FileCollection } from '../../components/FileCollection';
import { CommandDemo } from '../../components/CommandDemo';
import { Botanical } from '../../components/Homepage';
import { MoodSwitcher } from '../../components/MoodSwitcher';
const recipes: Record<string, {what: string; why: string; parts: string; steps: string[]}> = {
  'editorial-hero': {what: 'Introduce a collection with one story and one live preview.', why: 'A dominant headline gives a reader a clear starting point before they explore the product.', parts: 'Adaptive Header, Media Surface, Context Capsule, Button, Soft Mosaic Tile', steps: ['Write one headline and a short supporting paragraph.', 'Pair the story with a larger tonal media anchor and a smaller working control.', 'Keep story, preview, and action in that DOM order as the mosaic becomes one column.']},
  settings: {what: 'Edit a workspace name, type, and summary preference.', why: 'Related settings belong in one focused task with feedback beside the field.', parts: 'Floating Inspector, Input, Select, Checkbox, Button, Toast', steps: ['Label every field and start with meaningful example values.', 'Keep optional choices below the required name and validate on save.', 'Focus an invalid field; announce a successful local save without moving focus.']},
  dashboard: {what: 'Read studio progress and compare synthetic projects.', why: 'One metric establishes context while the chart and table support a closer reading.', parts: 'Adaptive Header, Metric, Chart, Data Table, Status Badge', steps: ['Lead with one value, its unit, and comparison period.', 'Choose a chart that answers one question and expose the underlying values.', 'Follow with a sortable table; keep horizontal scrolling within the table.']},
  'ai-conversation': {what: 'Read a prepared response and add a local message.', why: 'Speaker identity and a visible composer keep the next action clear.', parts: 'AI Message, AI Composer, Textarea, Button, Context Capsule', steps: ['Name the speakers and show the current context.', 'Keep the log above a labeled multiline composer.', 'Validate empty messages, append bounded text, and announce the prepared response.']},
  'file-manager': {what: 'Find a document in a synthetic studio collection.', why: 'A visible query and explicit empty state make filtering understandable.', parts: 'Input, Media Surface, Status Badge, Empty State', steps: ['Start with a semantic list of descriptive file names.', 'Filter locally from a labeled search field.', 'Show the count and offer a reset when nothing matches.']},
  'search-results': {what: 'Search the published catalog and open a result.', why: 'A short route from question to destination keeps the system approachable.', parts: 'Input, Soft Command Bar, Empty State, Status Badge', steps: ['Keep the query visible and bounded.', 'Group results by what they describe and name each destination.', 'Announce result counts and preserve an obvious way to clear the query.']},
  'command-workflow': {what: 'Jump to a catalog entry through a modal command search.', why: 'A temporary foreground task avoids taking over the page navigation.', parts: 'Soft Command Bar, Dialog, Input, Scrollbar', steps: ['Open from a named trigger and focus the search field.', 'Move through filtered destinations with arrow keys.', 'Use Escape to close and restore focus, or follow a result to its stable anchor.']},
  'media-gallery': {what: 'Introduce a visual collection with a dominant media anchor.', why: 'Unequal scale gives the eye a starting point while captions carry meaning.', parts: 'Media Surface, Soft Mosaic Tile, Context Capsule', steps: ['Choose one primary image with a useful description.', 'Place smaller context on the shared grid without reordering the DOM.', 'Keep captions outside image detail and reflow to one readable column.']},
};
const patterns = catalog.filter(item => item.kind === 'pattern');
---
<Layout path="/patterns/">
  <div class="wrap page-intro"><p class="kicker">A grammar for real work</p><h1>Pieces become<br />places.</h1><p class="lead">Compose the same foundations into a story, a studio, or a space to think. These working examples stay entirely local.</p></div>
  <div class="wrap catalog-moods"><MoodSwitcher client:load /></div>
  <div class="wrap pattern-list">{patterns.map(item => <section class="pattern-section" id={item.id}><div class="pattern-description"><p class="kicker">{item.category}</p><h2>{item.title}</h2><h3>What it does</h3><p>{recipes[item.id]?.what}</p><h3>Why this composition</h3><p>{recipes[item.id]?.why}</p><h3>Components to combine</h3><p>{recipes[item.id]?.parts}</p><h3>How to build it</h3><ol>{recipes[item.id]?.steps.map(step => <li>{step}</li>)}</ol><details><summary>Accessibility notes</summary><p>{item.accessibility}</p></details></div><div class="pattern-preview">
    {item.id === 'editorial-hero' && <ModeComparison client:visible />}
    {item.id === 'settings' && <div class="surface-card"><h3>Fieldnotes studio</h3><SettingsForm client:visible /></div>}
    {item.id === 'dashboard' && <><Metric /><DataDemo client:visible /></>}
    {item.id === 'ai-conversation' && <Conversation client:visible />}
    {item.id === 'file-manager' && <FileCollection client:visible />}
    {(item.id === 'search-results' || item.id === 'command-workflow') && <CommandDemo client:visible />}
    {item.id === 'media-gallery' && <Botanical caption="Everyday shapes, considered together" />}
  </div></section>)}</div>
</Layout>
