---
import Layout from '../../layouts/Layout.astro';
import { MoodBoards } from '../../components/MoodBoards';
import { MoodSwitcher } from '../../components/MoodSwitcher';
---
<Layout path="/moods/">
  <div class="wrap page-intro"><p class="kicker">Eight atmospheres. One visual grammar.</p><h1>A familiar system.<br />A different feeling.</h1><p class="lead">Choose a mood to change the whole page. Typography, spacing, shapes, and behavior stay consistent.</p></div>
  <div class="wrap catalog-moods"><MoodSwitcher client:load /></div>
  <div class="wrap"><MoodBoards client:load /></div>
</Layout>
